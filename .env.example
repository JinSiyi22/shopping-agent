# ============================================================
# LLM
# ============================================================

# OpenAI-compatible API credentials.
# Examples: Groq, OpenAI, or another compatible endpoint.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional cost estimation.
# Unit: USD per 1 million tokens.
# Leave empty to record token usage without estimating cost.
LLM_INPUT_COST_PER_1M=
LLM_OUTPUT_COST_PER_1M=


# ============================================================
# Agent Runtime
# ============================================================

# Number of top candidates sent to parallel candidate research.
PARALLEL_RESEARCH_TOP_N=2

# Maximum number of concurrent candidate research tasks.
RESEARCH_CONCURRENCY=2


# ============================================================
# Redis / Session / Cache
# ============================================================

REDIS_URL=redis://localhost:6379/0

# LangGraph checkpoint TTL, in minutes.
CHECKPOINT_TTL_MINUTES=1440

# Session registry TTL, in seconds.
SESSION_TTL_SECONDS=86400

# Tool-result cache TTL, in seconds.
TOOL_CACHE_TTL_SECONDS=1800


# ============================================================
# Product Catalog
# ============================================================

# Small mock catalog:
# PRODUCT_DATA_PATH=data/products.json

# Real Amazon-derived runtime catalog:
PRODUCT_DATA_PATH=data/products_real.json


# ============================================================
# Semantic Retrieval
# ============================================================

# Default implementation fallback:
# EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_DOCUMENT_PREFIX=

# Recommended configuration for the real English Amazon catalog:
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_QUERY_PREFIX=query:
EMBEDDING_DOCUMENT_PREFIX=passage:


# ============================================================
# Observability
# ============================================================

# Leave empty to disable trace-file export.
SHOPPING_AGENT_TRACE_DIR=

# Only enable for safe, non-private demo prompts.
SHOPPING_AGENT_TRACE_INCLUDE_TEXT=0


# ============================================================
# Evaluation
# ============================================================

EVAL_BASE_URL=http://127.0.0.1:8000
